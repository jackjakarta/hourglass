# gocron:job id=q1a2b3 name="Quotes and pipes"
0 * * * * /opt/gocron/gocron exec q1a2b3 -- 'echo "it'\''s $(date +\%H:\%M)" | tee -a /tmp/o.log >/dev/null'
# gocron:job id=q4c5d6 name="Percent raw"
0 0 * * * printf '\%s\n' "$(date +\%F)" > /tmp/date.txt
# gocron:job id=q7e8f9 name="Path with spaces"
5 * * * * '/home/jack/my tools/gocron' exec --timeout=1h30m q7e8f9 -- 'cd ~/proj && make'
# gocron:job id=qahand name="Hand edited"
10 * * * * gocron exec qahand -- echo two words
# gocron:job id=qbflag name="Unknown flag"
15 * * * * gocron exec --tee qbflag -- 'echo tee'
