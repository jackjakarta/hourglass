  1 env     MAILTO=""
  2 jobmeta id="k3f9a2" name="Nightly backup" tags="backup,db" desc="Dump app DB to /bk"
  3 jobline sched="30 2 * * *" cmd="/home/jack/.local/bin/hourglass exec --timeout=30m --no-overlap k3f9a2 -- 'pg_dump app | gzip > /bk/app-$(date +\\%F).sql.gz'"
  4 jobmeta id="p7m2qd" name="Say hi"
  5 jobline sched="0 9 * * 1-5" cmd="notify-send \"hi\""
  6 jobmeta id="zz7aaq" name="Sync" tags="photos" future_key="kept as is"
  7 jobline sched="*/15 * * * *" cmd="/usr/local/bin/hourglass exec zz7aaq -- 'rsync -a ~/Pictures/ nas:/photos/'"
