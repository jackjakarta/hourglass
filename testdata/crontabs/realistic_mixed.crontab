# Edit this file to introduce tasks to be run by cron.
#
# m h  dom mon dow   command
SHELL=/bin/bash
PATH=/home/jack/.local/bin:/usr/local/bin:/usr/bin:/bin
MAILTO=""

@reboot ~/bin/start-tmux.sh
*/5 * * * * ~/bin/sync.sh >/dev/null 2>&1

# gocron:job id=k3f9a2 name="Nightly backup" tags=backup,db desc="Dump app DB to /bk"
30 2 * * * /home/jack/.local/bin/gocron exec --timeout=30m --no-overlap k3f9a2 -- 'pg_dump app | gzip > /bk/app-$(date +\%F).sql.gz'
# gocron:job id=s7nc0p name="Sync photos" tags=photos
*/15 * * * * /home/jack/.local/bin/gocron exec --no-overlap s7nc0p -- 'rsync -a ~/Pictures/ nas:/photos/'
# gocron:job id=pdk4r2 name="Prune docker"
0 4 * * 0 /home/jack/.local/bin/gocron exec pdk4r2 -- 'docker system prune -af'
# gocron:job id=r0tl6s name="Rotate logs"
0 * * * * /home/jack/.local/bin/gocron exec r0tl6s -- 'logrotate -s ~/.logrotate.state ~/.logrotate.conf'
# gocron:job id=wkrp7t name="Weekly report"
#gocron:off 0 9 * * 1 /home/jack/.local/bin/gocron exec wkrp7t -- '~/bin/report --weekly'
# gocron:job id=p7m2qd name="Say hi"
0 9 * * 1-5 notify-send "hi"
0 0 1 * 1 ~/bin/first-or-monday.sh
