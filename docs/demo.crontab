SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""

@reboot ~/bin/start-tmux.sh

# gocron:job id=k3f9a2 name="Nightly backup" tags=backup,db
30 2 * * * /usr/local/bin/gocron exec --timeout=30m --no-overlap k3f9a2 -- 'pg_dump app | gzip > /bk/app-$(date +\%F).sql.gz'
# gocron:job id=s7nc0p name="Sync photos" tags=photos
*/15 * * * * /usr/local/bin/gocron exec --no-overlap s7nc0p -- 'rsync -a ~/Pictures/ nas:/photos/'
# gocron:job id=pdk4r2 name="Prune docker" tags=ops
0 4 * * 0 /usr/local/bin/gocron exec pdk4r2 -- 'docker system prune -af'
# gocron:job id=r0tl6s name="Rotate logs" tags=ops
0 * * * * /usr/local/bin/gocron exec r0tl6s -- 'logrotate -s ~/.logrotate.state ~/.logrotate.conf'
# gocron:job id=wkrp7t name="Weekly report"
#gocron:off 0 9 * * 1 /usr/local/bin/gocron exec wkrp7t -- '~/bin/report --weekly'
